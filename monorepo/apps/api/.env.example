# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/al3amer-pos

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here

# Paymob Integration
# Used to verify webhooks from Paymob. You can find this in your Paymob Dashboard -> Settings.
PAYMOB_HMAC_SECRET=your_hmac_secret_here

# Encryption Key (AES-256 for DB encryption)
# Must be exactly 32 bytes (64 hex characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Config
PORT=3000
NODE_ENV=development
SITE_URL=https://al3amer.store
