{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/sitemap.xml"
        },
        {
            "source": "/sitemap_llm.xml",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/sitemap_llm.xml"
        },
        {
            "source": "/llm-catalog.md",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/llm-catalog.md"
        },
        {
            "source": "/api/(.*)",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/$1"
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(whatsapp|telegram|facebookexternalhit|twitterbot|linkedinbot|pinterest|slackbot|discordbot|googlebot).*"
                }
            ],
            "destination": "https://al3amer-store-wf1t.vercel.app/api/social-preview/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}