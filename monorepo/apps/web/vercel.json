{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://al3amer-store-wf1t.vercel.app/sitemap.xml"
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(whatsapp|telegram|facebookexternalhit|twitterbot|linkedinbot|pinterest|slackbot|discordbot|googlebot).*"
                }
            ],
            "destination": "https://al3amer-store-wf1t.vercel.app/api/social-preview/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}