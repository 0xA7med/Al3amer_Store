{
    "headers": [
        {
            "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|gif|woff|woff2|ttf|eot|mp4|webm)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/sitemap.xml"
        },
        {
            "source": "/sitemap_llm.xml",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/sitemap_llm.xml"
        },
        {
            "source": "/llm-catalog.md",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/llm-catalog.md"
        },
        {
            "source": "/api/(.*)",
            "destination": "https://al3amer-store-wf1t.vercel.app/api/$1"
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(whatsapp|telegram|facebookexternalhit|twitterbot|linkedinbot|pinterest|slackbot|discordbot).*"
                }
            ],
            "destination": "https://al3amer-store-wf1t.vercel.app/api/social-preview/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}